# Buildroot's board/raspberrypi/genimage.cfg.in with a 64M boot partition
# instead of 32M: it also holds the boot log, example configs and disabled/.
image boot.vfat {
	vfat {
		label = "RPI5OS-BOOT"
		files = {
#BOOT_FILES#
		}
	}

	size = 64M
}

image sdcard.img {
	hdimage {
	}

	partition boot {
		partition-type = 0xC
		bootable = "true"
		image = "boot.vfat"
	}

	partition rootfs {
		partition-type = 0x83
		image = "rootfs.ext4"
	}
}
