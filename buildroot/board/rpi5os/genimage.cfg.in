# Як board/raspberrypi/genimage.cfg.in з Buildroot, але boot-розділ 64M
# замість 32M: туди ще пишуться лог, приклади конфігів і тека disabled/.
image boot.vfat {
	vfat {
		label = "RPI5OS-BOOT"
		files = {
#BOOT_FILES#
		}
	}

	size = 64M
}

image sdcard.img {
	hdimage {
	}

	partition boot {
		partition-type = 0xC
		bootable = "true"
		image = "boot.vfat"
	}

	partition rootfs {
		partition-type = 0x83
		image = "rootfs.ext4"
	}
}
