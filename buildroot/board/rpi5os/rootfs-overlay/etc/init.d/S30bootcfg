#!/bin/sh
#
# S30bootcfg: підхоплює налаштування з FAT-розділу /boot.
#
#   /boot/userconf.txt        "ім'я:hash" → користувач у групі wheel, файл видаляється
#   /boot/wpa_supplicant.conf → /etc/wpa_supplicant.conf (600), файл видаляється
#
# В образі немає ні користувачів, ні пароля Wi-Fi: їх дає той, хто записав SD.

. /usr/lib/rpi5os/common.sh

apply_userconf() {
	f=/boot/userconf.txt
	[ -f "$f" ] || return 0

	line=$(tr -d '\r' < "$f" | grep -v '^[[:space:]]*#' | grep -m1 ':')
	rm -f "$f"
	sync
	name=${line%%:*}
	hash=${line#*:}

	case "$name" in
		''|*[!a-z0-9_-]*) log "userconf: погане ім'я користувача, пропускаю"; return 1 ;;
	esac
	# Тільки sha256/sha512-crypt: їх точно розуміє crypt() у sshd і sudo.
	case "$hash" in
		'$5$'*|'$6$'*) ;;
		*) log "userconf: hash має бути з 'openssl passwd -6', пропускаю"; return 1 ;;
	esac

	grep -q "^${name}:" /etc/passwd || adduser -D -s /bin/sh "$name"
	addgroup "$name" wheel 2>/dev/null || true
	# У crypt-алфавіті немає '|', '&' і '\', тож hash безпечно підставляти в sed.
	sed -i "s|^${name}:[^:]*:|${name}:${hash}:|" /etc/shadow
	log "userconf: користувач ${name} готовий (група wheel)"
}

apply_wpa() {
	f=/boot/wpa_supplicant.conf
	[ -f "$f" ] || return 0

	umask 077
	tr -d '\r' < "$f" > /etc/wpa_supplicant.conf.new
	chmod 600 /etc/wpa_supplicant.conf.new
	mv /etc/wpa_supplicant.conf.new /etc/wpa_supplicant.conf
	rm -f "$f"
	sync
	log "wpa: конфіг перенесено в /etc/wpa_supplicant.conf"
}

case "$1" in
	start)
		if ! mountpoint -q /boot; then
			mount /boot || { echo "S30bootcfg: /boot не змонтовано"; exit 1; }
		fi
		apply_userconf
		apply_wpa
		;;
	stop|restart|reload)
		;;
	*)
		echo "Usage: $0 {start|stop}"
		exit 1
esac

exit 0
