From: rpi5os <noreply@example.invalid>
Subject: [PATCH] Build against libcamera 0.6: properties::Model is a string_view

libcamera 0.6 (meta-multimedia, used by meta-raspberrypi wrynose) returns
properties::Model as std::string_view; rpicam-apps 1.9.0 still assigns it to
std::string implicitly, which does not compile. Construct the string
explicitly.

Upstream-Status: Inappropriate [rpicam-apps 1.9.0 pinned by meta-raspberrypi; newer releases build against libcamera 0.6]
---
--- a/core/options.cpp
+++ b/core/options.cpp
@@ -418,7 +418,7 @@
 	std::vector<std::shared_ptr<libcamera::Camera>> cameras = app->GetCameras();
 	if (camera < cameras.size())
 	{
-		const std::string cam_id = *cameras[camera]->properties().get(libcamera::properties::Model);
+		const std::string cam_id(*cameras[camera]->properties().get(libcamera::properties::Model));
 
 		if (cam_id.find("imx708") != std::string::npos)
 		{
--- a/core/rpicam_app.cpp
+++ b/core/rpicam_app.cpp
@@ -129,7 +129,7 @@
 std::string RPiCamApp::CameraModel() const
 {
 	auto model = camera_->properties().get(properties::Model);
-	return model ? *model : camera_->id();
+	return model ? std::string(*model) : camera_->id();
 }
 
 void RPiCamApp::OpenCamera()
